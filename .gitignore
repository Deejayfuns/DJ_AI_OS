# =====================================================
# DJ AI OS - .gitignore
# =====================================================

# Ortam
.venv/
__pycache__/
*.pyc

# Veritabanları (çalışma anında üretilir)
*.db
*.db.txt
dj_ai_library.db
data/dj_database.db*
data/dj_memory.db

# Loglar
data/logs/

# Bellek / öğrenme verisi (kullanıcı verisi, çalışma anında üretilir)
astra_memory.json
astra_graph_memory.json
dj_memory.json
app/config/discovered_genres.json

# Üretilen çıktı klasörleri
DJ_LIBRARY_OUTPUT/
DJ_EXPORTS/
DJ_REMIX_LAB/
DJ_COMMERCIAL/

# Lisans
license.key
# Vendor private key (YALNIZCA vendor makinesi — asla commit etme)
vendor_private_key.pem
# Geliştirici tam-lisans bayrağı (owner_dev_mode için açık kapı)
dev.flag
# Environment files
.env
.env.local

# Paketleme / arşiv
dj_ai_os.zip
build/
dist/
*.spec

# Üretilen ses dosyaları
generated_beat_*.wav

# Bulut indirme önbelleği (çalışma anında üretilir)
DJ_CLOUD_DOWNLOADS/

# Update üretim çıktıları (tools/build_manifest.py)
updates/

# Boot / teşhis çıktıları (hata ayıklama sırasında üretilir)
*_probe.py
*_probe_out.txt
boot_out*.txt
boot_test_out*.txt
mw_test*.txt
launch_*.log
boot_selftest_out.txt
boot_selftest_stdout.log
