# DJ AI OS — Environment Configuration (COPY TO .env)

# ─── Database ───
# Prod (PostgreSQL): postgresql+asyncpg://user:pass@host:5432/db
# Dev (SQLite):      sqlite+aiosqlite:///./dj_ai_os_dev.db (default)
DJ_AI_OS_DATABASE_URL=postgresql+asyncpg://dj_ai:devpass@localhost:5432/dj_ai_os

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Admin Auth ───
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=your_admin_token_here

# ─── Server ───
DJ_AI_OS_API_PORT=8000
DJ_AI_OS_API_RELOAD=false

# ─── Vendor License Signing (ONLY on vendor machine) ───
# Public key is embedded in app/config/vendor_public_key.py
# Private key is gitignored vendor_private_key.pem or env:
DJ_AI_OS_LICENSE_PRIVATE_KEY=

# ─── Client ───
DJ_AI_OS_API_URL=https://api.dj-ai-os.example

# ─── Debug ───
DJ_AI_OS_DB_ECHO=false
